<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HKA_Handball.MainMenuPage"
             BackgroundColor="{StaticResource ArenaNavy}"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172D48" Offset="0" />
            <GradientStop Color="#09131F" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <ScrollView VerticalScrollBarVisibility="Default">
        <VerticalStackLayout Padding="24,20" Spacing="18" MaximumWidthRequest="560"
                             HorizontalOptions="Center">
            <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
                <Border x:Name="BallFrame" BackgroundColor="{StaticResource AranasBlue}"
                        Stroke="#4E9AEE" StrokeShape="RoundRectangle 18"
                        WidthRequest="60" HeightRequest="60" Padding="0">
                    <Label Text="HKA" TextColor="White" FontSize="18" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="HKA HANDBALL" TextColor="White" FontSize="27"
                           FontAttributes="Bold" CharacterSpacing="1" />
                    <Label Text="Din hemmaplan. Ditt spel." TextColor="{StaticResource MutedText}"
                           FontSize="13" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="{StaticResource SurfaceNavy}" Stroke="{StaticResource PanelStroke}"
                    StrokeShape="RoundRectangle 22" Padding="22">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="DAGS FÖR AVKAST" TextColor="{StaticResource IceBlue}"
                               FontSize="11" FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Text="Välj din match" TextColor="White" FontSize="24" FontAttributes="Bold" />
                        <Label Text="En riktig hall. Två lag. Helt offline."
                               TextColor="{StaticResource MutedText}" FontSize="13" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="SinglePlayerButton" Text="1 spelare" FontSize="16"
                                FontAttributes="Bold" HeightRequest="54" CornerRadius="12"
                                Style="{StaticResource PressableButtonStyle}" Clicked="OnSinglePlayer"
                                SemanticProperties.Description="Starta match mot datorn" />
                        <Button x:Name="TwoPlayerButton" Grid.Column="1" Text="2 spelare · lokal"
                                FontSize="14" FontAttributes="Bold" HeightRequest="54" CornerRadius="12"
                                BackgroundColor="#243D56" BorderColor="#4B6682" BorderWidth="1"
                                Style="{StaticResource PressableButtonStyle}" Clicked="OnTwoPlayerLocal" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource PanelStroke}" />
                    <Label Text="Svårighetsgrad" FontSize="14" FontAttributes="Bold" TextColor="White" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button x:Name="EasyButton" Text="Lätt" FontSize="14" HeightRequest="44"
                                CornerRadius="10" Clicked="OnSelectEasy" />
                        <Button x:Name="MediumButton" Grid.Column="1" Text="Normal" FontSize="14"
                                HeightRequest="44" CornerRadius="10" Clicked="OnSelectMedium" />
                        <Button x:Name="HardButton" Grid.Column="2" Text="Svår" FontSize="14"
                                HeightRequest="44" CornerRadius="10" Clicked="OnSelectHard" />
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Matchställ" FontSize="14" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Välj färg för hemma- och bortalaget."
                               TextColor="{StaticResource MutedText}" FontSize="12" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="HEMMA" FontSize="11" CharacterSpacing="1"
                                   FontAttributes="Bold" TextColor="{StaticResource MutedText}" />
                            <Grid x:Name="HomeColorStack" ColumnDefinitions="*,*,*,*"
                                  RowDefinitions="44,44" ColumnSpacing="6" RowSpacing="6" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="BORTA" FontSize="11" CharacterSpacing="1"
                                   FontAttributes="Bold" TextColor="{StaticResource MutedText}" />
                            <Grid x:Name="AwayColorStack" ColumnDefinitions="*,*,*,*"
                                  RowDefinitions="44,44" ColumnSpacing="6" RowSpacing="6" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource PanelStroke}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="Matchljud" FontSize="14" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Visselpipa, boll och publik." FontSize="12"
                                   TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Switch x:Name="SoundSwitch" Grid.Column="1" IsToggled="True"
                                OnColor="{StaticResource AranasBlueLight}" Toggled="OnSoundToggled"
                                SemanticProperties.Description="Matchljud på eller av" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label x:Name="VersionLabel" FontSize="11" TextColor="{StaticResource MutedText}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
