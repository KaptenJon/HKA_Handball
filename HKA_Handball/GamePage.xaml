<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HKA_Handball.Controls"
             x:Class="HKA_Handball.GamePage"
             Title="HKA Handball"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource ArenaNavy}">
    <Grid>
        <GraphicsView x:Name="GameView"
                      HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand">
            <GraphicsView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <Button x:Name="CameraButton"
                Text="Kamera: TV fast"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="8"
                Padding="10,4"
                HeightRequest="44"
                FontSize="11"
                BackgroundColor="#DF0D1928"
                TextColor="#F4F4F4"
                CornerRadius="12"
                SemanticProperties.Description="Byt mellan fast TV-kamera, följande TV-kamera och plan taktisk kamera"
                Clicked="OnCameraClicked" />

        <!-- Status badge top center, below the scoreboard -->
        <Border x:Name="StatusBadge"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="12,62,12,0"
                Padding="10,6"
                BackgroundColor="#E616283D"
                Stroke="{StaticResource PanelStroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                InputTransparent="True">
            <Border.Shadow>
                <Shadow Brush="#80000000" Offset="0,3" Radius="8" Opacity="0.35" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                <BoxView x:Name="StatusAccent"
                         WidthRequest="4"
                         CornerRadius="2"
                         Color="#66FFFFFF"
                         VerticalOptions="Fill" />
                <Label x:Name="StatusLabel"
                       Grid.Column="1"
                       TextColor="#F4F4F4"
                       FontSize="12"
                       LineBreakMode="WordWrap"
                       MaxLines="2"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- PLAYER 1 LEFT THUMB: Joystick -->
        <Border x:Name="JoystickPanel"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="12,0,0,12"
                Padding="4"
                BackgroundColor="#A60D1928"
                Stroke="{StaticResource PanelStroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26">
            <Border.Shadow>
                <Shadow Brush="#80000000" Offset="0,4" Radius="10" Opacity="0.35" />
            </Border.Shadow>
            <controls:JoystickView x:Name="Joystick" WidthRequest="112" HeightRequest="112"
                                   SemanticProperties.Description="Flytta hemmaspelaren" />
        </Border>

        <!-- PLAYER 1 RIGHT THUMB: Action buttons (single-player and two-player, left side) -->
        <Border x:Name="Player1Buttons"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,12,12"
                Padding="8"
                BackgroundColor="#DF0D1928"
                Stroke="{StaticResource PanelStroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26">
            <Border.Shadow>
                <Shadow Brush="#80000000" Offset="0,4" Radius="10" Opacity="0.35" />
            </Border.Shadow>
            <Grid x:Name="Player1ButtonsGrid"
                  RowDefinitions="Auto,Auto" ColumnDefinitions="*,*"
                  RowSpacing="6" ColumnSpacing="6">

                <!-- Attack controls (visible when attacking) -->
                <Button x:Name="PassUpButton" Text="↑ Pass" FontSize="14"
                        BackgroundColor="#003DA5" TextColor="White" CornerRadius="12"
                        HeightRequest="44" MinimumWidthRequest="76"
                        Style="{StaticResource PressableButtonStyle}"
                        Pressed="OnPassUp" />
                <Button x:Name="PassDownButton" Grid.Column="1" Text="↓ Pass" FontSize="14"
                        BackgroundColor="#003DA5" TextColor="White" CornerRadius="12"
                        HeightRequest="44" MinimumWidthRequest="76"
                        Style="{StaticResource PressableButtonStyle}"
                        Pressed="OnPassDown" />
                <controls:GoalAimView x:Name="HomeGoalAim" Grid.Row="1" Grid.ColumnSpan="2"
                        HeightRequest="128" SemanticProperties.Description="Tryck i målet för att sikta och skjuta" />

                <!-- Defense controls (visible when defending) -->
                <Button x:Name="SwitchDefenderButton" Grid.ColumnSpan="2" Text="Byt försvarare" FontSize="14"
                        BackgroundColor="#B7791F" TextColor="White" CornerRadius="12"
                        HeightRequest="44" MinimumWidthRequest="76"
                        Style="{StaticResource PressableButtonStyle}"
                        Pressed="OnSwitchDefender" />
            </Grid>
        </Border>

        <!-- PLAYER 2 RIGHT THUMB: Joystick (two-player mode only) -->
        <Border x:Name="Joystick2Panel"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,182,12"
                Padding="4"
                BackgroundColor="#A60D1928"
                Stroke="{StaticResource PanelStroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26"
                IsVisible="False">
            <Border.Shadow>
                <Shadow Brush="#80000000" Offset="0,4" Radius="10" Opacity="0.35" />
            </Border.Shadow>
            <controls:JoystickView x:Name="Joystick2" WidthRequest="112" HeightRequest="112"
                                   SemanticProperties.Description="Flytta bortaspelaren" />
        </Border>

        <!-- PLAYER 2 LEFT THUMB: Action buttons for away team (two-player mode only) -->
        <Border x:Name="Player2Buttons"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="182,0,0,12"
                Padding="8"
                BackgroundColor="#DF0D1928"
                Stroke="{StaticResource PanelStroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26"
                IsVisible="False">
            <Border.Shadow>
                <Shadow Brush="#80000000" Offset="0,4" Radius="10" Opacity="0.35" />
            </Border.Shadow>
            <Grid x:Name="Player2ButtonsGrid"
                  RowDefinitions="Auto,Auto" ColumnDefinitions="*,*"
                  RowSpacing="6" ColumnSpacing="6">

                <!-- Away attack controls -->
                <Button x:Name="AwayPassUpButton" Text="↑ Pass" FontSize="14"
                        BackgroundColor="#B71C1C" TextColor="White" CornerRadius="12"
                        HeightRequest="44" MinimumWidthRequest="76"
                        Style="{StaticResource PressableButtonStyle}"
                        Pressed="OnAwayPassUp" />
                <Button x:Name="AwayPassDownButton" Grid.Column="1" Text="↓ Pass" FontSize="14"
                        BackgroundColor="#B71C1C" TextColor="White" CornerRadius="12"
                        HeightRequest="44" MinimumWidthRequest="76"
                        Style="{StaticResource PressableButtonStyle}"
                        Pressed="OnAwayPassDown" />
                <controls:GoalAimView x:Name="AwayGoalAim" Grid.Row="1" Grid.ColumnSpan="2"
                        HeightRequest="128" SemanticProperties.Description="Tryck i målet för att sikta och skjuta" />

                <!-- Away defense controls -->
                <Button x:Name="AwaySwitchDefenderButton" Grid.ColumnSpan="2" Text="Byt försvarare" FontSize="14"
                        BackgroundColor="#B7791F" TextColor="White" CornerRadius="12"
                        HeightRequest="44" MinimumWidthRequest="76"
                        Style="{StaticResource PressableButtonStyle}"
                        Pressed="OnAwaySwitchDefender" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
